# =============================================================================
# AW-Companion — Configurazione tramite variabili d'ambiente
# =============================================================================
# Copia questo file in .env e compila i valori obbligatori.
# [OBBLIGATORIO] — nessun valore predefinito, deve essere impostato.
# [OPZIONALE]    — mostra il valore predefinito.
# =============================================================================


# -----------------------------------------------------------------------------
# AnimeWorld
# -----------------------------------------------------------------------------

# [OPZIONALE] URL base di AnimeWorld. Aggiornalo se il dominio cambia (es. da .ac a .tv).
# Predefinito: https://www.animeworld.ac
AW_BASE_URL=https://www.animeworld.ac


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# [OBBLIGATORIO] Chiave segreta per autenticare le richieste API provenienti da Sonarr.
# Genera una stringa casuale (es. openssl rand -hex 16).
AWC_API_KEY=

# [OPZIONALE] Porta su cui il server HTTP è in ascolto. Predefinito: 7004
AWC_PORT=7004

# [OPZIONALE] URL pubblico di questa istanza, usato per costruire l'URL del feed
# Torznab restituito a Sonarr. Se non impostato, usa http://localhost:7004.
# Impostalo quando Sonarr gira su un host diverso o dietro un reverse proxy.
# Esempio: http://192.168.1.10:7004  oppure  https://awc.miodominio.com
AWC_URL=

# [OPZIONALE] Livello di verbosità dei log. Valori: DEBUG, INFO, WARNING, ERROR. Predefinito: INFO
LOG_LEVEL=INFO

# [OPZIONALE] Fuso orario del container (influenza i timestamp dei log). Predefinito: Europe/Rome
TZ=Europe/Rome


# -----------------------------------------------------------------------------
# Docker — proprietà dei file all'interno del container
# -----------------------------------------------------------------------------

# [OPZIONALE] UID / GID proprietari dei volumi /config e /data. Predefinito: 1000
PUID=1000
PGID=1000


# -----------------------------------------------------------------------------
# Sonarr
# -----------------------------------------------------------------------------

# [OBBLIGATORIO] URL base della tua istanza Sonarr (senza slash finale).
# Esempio: http://192.168.1.10:8989
SONARR_URL=

# [OBBLIGATORIO] Chiave API di Sonarr (Impostazioni → Generali → Chiave API).
SONARR_API_KEY=

# [OPZIONALE] Nome del tag Sonarr che identifica le serie anime. Solo le serie
# con questo tag vengono sincronizzate ed elaborate dall'automap. Predefinito: anime
SONARR_ANIME_TAG=anime

# [OPZIONALE] Ogni quanti minuti sincronizzare i metadati di serie e stagioni
# da Sonarr. Dopo ogni sync, le stagioni non mappate vengono ritentate dall'automap.
# Predefinito: 30
SONARR_SYNC_INTERVAL=30

# [OPZIONALE] Ogni quanti secondi il poller controlla la cronologia di Sonarr
# per rilevare file appena importati dal blackhole. Predefinito: 60
SONARR_IMPORT_POLL_INTERVAL=60

# [OPZIONALE] Rimuove automaticamente il monitoraggio di un episodio in Sonarr
# dopo che AWC ne rileva l'importazione. Imposta true per abilitare. Predefinito: false
SONARR_UNMONITOR_IMPORTED=false

# [OPZIONALE] Nome del tag Sonarr che indica preferenza per l'audio doppiato.
# Se presente su una serie, l'automap privilegia i link AW doppiati per quella serie.
# Predefinito: ita
SONARR_DUB_TAG=ita


# -----------------------------------------------------------------------------
# Automap
# -----------------------------------------------------------------------------

# [OPZIONALE] Punteggio minimo di confidenza (0–100) affinché un link AnimeWorld
# venga accettato come mappatura automatica. Valori più bassi mappano più serie
# ma aumentano il rischio di falsi positivi. Predefinito: 85
AUTOMAP_CONFIDENCE_THRESHOLD=85

# [OPZIONALE] Differenza massima nel conteggio episodi (0–100, in percentuale)
# tollerata nel confronto tra Sonarr e AnimeWorld durante il rilevamento split-cour.
# Predefinito: 20
AUTOMAP_EPISODE_TOLERANCE=20


# -----------------------------------------------------------------------------
# Download
# -----------------------------------------------------------------------------

# [OPZIONALE] Numero massimo di download simultanei. Predefinito: 10
MAX_CONCURRENT_DOWNLOADS=10

# [OPZIONALE] Numero di giorni di conservazione della cronologia download
# (voci importate, cancellate o fallite). Le voci completate in attesa di
# importazione da parte di Sonarr vengono conservate fino all'importazione
# indipendentemente da questa impostazione. Predefinito: 7
DOWNLOAD_HISTORY_DAYS=7


# -----------------------------------------------------------------------------
# RSS — consegna automatica degli episodi a Sonarr
# -----------------------------------------------------------------------------
# Quando abilitato, AWC interroga il feed RSS di AnimeWorld, risolve i nuovi
# episodi rispetto alle mappature esistenti, recupera gli URL CDN e li memorizza
# come feed Torznab che Sonarr interroga per avviare i download automatici.
# Richiede AWC_URL e l'indexer di Sonarr puntato a http://<AWC_URL>/api.

# [OPZIONALE] Abilita la pipeline RSS. Predefinito: false
RSS_ENABLED=false

# [OPZIONALE] Ogni quanti secondi interrogare il feed RSS di AnimeWorld per
# nuovi episodi. Predefinito: 300 (5 minuti)
RSS_POLL_INTERVAL=300

# [OPZIONALE] Quanti giorni conservare gli elementi RSS nella cache del database.
# Predefinito: 30
RSS_CACHE_RETENTION_DAYS=30

# [OPZIONALE] Numero massimo di elementi restituiti per ogni interrogazione
# RSS da parte di Sonarr. Predefinito: 100
RSS_CACHE_LIMIT=100
