# =============================================================================
# AW-Companion — Configurazione tramite variabili d'ambiente
# =============================================================================
# Copia questo file in .env e compila i valori obbligatori.
# [OBBLIGATORIO] — nessun valore predefinito, deve essere impostato.
# [OPZIONALE]    — mostra il valore predefinito.
# =============================================================================


# -----------------------------------------------------------------------------
# AnimeWorld
# -----------------------------------------------------------------------------

# [OPZIONALE] URL base di AnimeWorld. Aggiornalo se il dominio cambia (es. da .ac a .tv).
# Predefinito: https://www.animeworld.ac
AW_BASE_URL=https://www.animeworld.ac


# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------

# [OBBLIGATORIO] Chiave segreta per autenticare le richieste API provenienti da Sonarr.
# Genera una stringa casuale (es. openssl rand -hex 16).
AWC_API_KEY=

# [OPZIONALE] Porta su cui il server HTTP è in ascolto. Predefinito: 7004
AWC_PORT=7004

# [OPZIONALE] URL pubblico di questa istanza, usato per costruire l'URL del feed
# Torznab restituito a Sonarr e Radarr. Se non impostato, usa il valore vuoto
# e AWC ricava gli URL pubblici dal contesto della richiesta quando possibile.
# Impostalo quando Sonarr gira su un host diverso o dietro un reverse proxy.
# Esempio: http://192.168.1.10:7004  oppure  https://awc.miodominio.com
AWC_URL=

# [OPZIONALE] Livello di verbosità dei log. Valori: DEBUG, INFO, WARNING, ERROR. Predefinito: INFO
LOG_LEVEL=INFO

# [OPZIONALE] Abilita la persistenza strutturata dei log in un database SQLite
# separato, lasciando invariati anche i log su stdout/docker. Predefinito: true
LOG_DB_ENABLED=true

# [OPZIONALE] Percorso del database SQLite che conserva la cronologia dei log.
# Predefinito nel container: /config/logging.db
AWC_LOGGING_DB_PATH=/config/logging.db

# [OPZIONALE] Giorni di retention della cronologia log persistita. Predefinito: 30
LOG_DB_RETENTION_DAYS=30

# [OPZIONALE] Fuso orario del container (influenza i timestamp dei log). Predefinito: Europe/Rome
TZ=Europe/Rome

# [OPZIONALE] Percorso locale dove AWC salva e gestisce i file di download.
# Predefinito: /data
AWC_DATA_PATH=/data

# [OPZIONALE] Percorso del database SQLite usato da AWC. Nel container il
# valore predefinito punta a /config/database.db. Predefinito: /config/database.db
AWC_DATABASE_PATH=/config/database.db


# -----------------------------------------------------------------------------
# Docker — proprietà dei file all'interno del container
# -----------------------------------------------------------------------------

# [OPZIONALE] UID / GID proprietari dei volumi /config e /data. Predefinito: 1000
PUID=1000
PGID=1000


# -----------------------------------------------------------------------------
# Sonarr
# -----------------------------------------------------------------------------

# [OBBLIGATORIO] URL base della tua istanza Sonarr (senza slash finale).
# Esempio: http://192.168.1.10:8989
SONARR_URL=

# [OBBLIGATORIO] Chiave API di Sonarr (Impostazioni → Generali → Chiave API).
SONARR_API_KEY=


# -----------------------------------------------------------------------------
# Radarr
# -----------------------------------------------------------------------------

# [OBBLIGATORIO] URL base della tua istanza Radarr (senza slash finale).
# Esempio: http://192.168.1.10:7878
RADARR_URL=

# [OBBLIGATORIO] Chiave API di Radarr (Impostazioni → Generali → Chiave API).
RADARR_API_KEY=


# -----------------------------------------------------------------------------
# Shared (Sonarr + Radarr)
# -----------------------------------------------------------------------------

# [OPZIONALE] Nome del tag che identifica gli elementi anime da sincronizzare.
# Per Sonarr può essere sovrascritto con SONARR_ANIME_TAG. Predefinito: anime
ANIME_TAG=anime

# [OPZIONALE] Nome del tag che indica preferenza per l'audio doppiato.
# Se non imposti SONARR_DUB_TAG, questo valore viene usato come fallback.
# Predefinito: ita
DUB_TAG=ita

# [OPZIONALE] Ogni quanti minuti eseguire il sync libreria in background.
# Predefinito: 30
SYNC_INTERVAL=30

# [OPZIONALE] Ogni quanti secondi il poller controlla la cronologia di import
# per rilevare file appena importati dal blackhole. Vale per Sonarr e Radarr.
# Predefinito: 60
IMPORT_POLL_INTERVAL=60

# [OPZIONALE] Rimuove automaticamente il monitoraggio dell'elemento importato
# dopo che AWC ne rileva l'importazione. Vale per Sonarr e Radarr.
# Imposta true per abilitare. Predefinito: false
UNMONITOR_IMPORTED=false

# [OPZIONALE] Elenco di tag separati da virgola. Se una serie o un film possiede
# almeno uno di questi tag nel manager, AWC non lo sincronizza e lo rimuove
# dal database locale se era già presente. Vale per Sonarr e Radarr.
# Esempio: ghibli,ignore-awc
IGNORE_TAG=


# -----------------------------------------------------------------------------
# Automap
# -----------------------------------------------------------------------------

# [OPZIONALE] Punteggio minimo di confidenza (0–100) affinché un link AnimeWorld
# venga accettato come mappatura automatica. Valori più bassi mappano più serie
# ma aumentano il rischio di falsi positivi. Predefinito: 85
AUTOMAP_CONFIDENCE_THRESHOLD=85

# [OPZIONALE] Punteggio minimo di confidenza (0–100) per l'automap film.
# Predefinito: 75
AUTOMAP_MOVIE_CONFIDENCE_THRESHOLD=75

# [OPZIONALE] Differenza massima nel conteggio episodi (0–100, in percentuale)
# tollerata nel confronto tra Sonarr e AnimeWorld durante il rilevamento split-cour.
# Predefinito: 20
AUTOMAP_EPISODE_TOLERANCE=20

# [OPZIONALE] Abilita il servizio sanitizer per la verifica periodica dei link
# AnimeWorld e il refresh automatico delle metadata/mappature auto. Imposta false
# per disattivare completamente sia il loop in background sia il trigger manuale.
# Predefinito: true
SANITIZER_ENABLED=true

# [OPZIONALE] Abilita il poller che prova l'automap solo sugli elementi non
# ignorati e ancora non mappati, con data di uscita futura o recente. Serve
# a promuovere automaticamente i placeholder pre-air e a coprire episodi/stagioni
# che diventano eleggibili senza dover lanciare ogni volta l'automap completa.
# Predefinito: true
ELIGIBLE_ENABLED=true

# [OPZIONALE] Ogni quanti secondi eseguire il poller degli elementi eleggibili
# per l'automap. Predefinito: 21600 (6 ore)
ELIGIBLE_INTERVAL=21600

# [OPZIONALE] Finestra in giorni per includere anche elementi usciti di recente
# ma ancora senza mapping. Tutti gli elementi futuri rientrano comunque.
# Predefinito: 14
ELIGIBLE_LOOKBACK_DAYS=14


# -----------------------------------------------------------------------------
# Download
# -----------------------------------------------------------------------------

# [OPZIONALE] Numero massimo di download simultanei. Predefinito: 10
MAX_CONCURRENT_DOWNLOADS=10

# [OPZIONALE] Numero di giorni di conservazione della cronologia download
# (voci importate, cancellate o fallite). Le voci completate in attesa di
# importazione da parte di Sonarr vengono conservate fino all'importazione
# indipendentemente da questa impostazione. Predefinito: 7
DOWNLOAD_HISTORY_DAYS=7


# -----------------------------------------------------------------------------
# RSS — consegna automatica degli episodi a Sonarr
# -----------------------------------------------------------------------------
# Quando abilitato, AWC interroga il feed RSS di AnimeWorld, risolve i nuovi
# episodi rispetto alle mappature esistenti, recupera gli URL CDN e li memorizza
# come feed Torznab che Sonarr interroga per avviare i download automatici.
# Richiede AWC_URL e l'indexer di Sonarr puntato a http://<AWC_URL>/api.

# [OPZIONALE] Abilita la pipeline RSS. Predefinito: false
RSS_ENABLED=false

# [OPZIONALE] Ogni quanti secondi interrogare il feed RSS di AnimeWorld per
# nuovi episodi. Predefinito: 300 (5 minuti)
RSS_POLL_INTERVAL=300

# [OPZIONALE] Quanti giorni conservare gli elementi RSS nella cache del database.
# Predefinito: 30
RSS_CACHE_RETENTION_DAYS=30

# [OPZIONALE] Numero massimo di elementi restituiti per ogni interrogazione
# RSS da parte di Sonarr. Predefinito: 100
RSS_CACHE_LIMIT=100
